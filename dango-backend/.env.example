# 团子账本 · Dango Ledger 环境变量示例
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会提交。

# 监听地址：真机/局域网调试用 0.0.0.0，只本机用 127.0.0.1
DANGO_HOST=0.0.0.0
DANGO_PORT=8000

# SQLite 文件路径；相对路径相对于 dango-backend/ 解析
DANGO_DATABASE=./data/dango.db

# 生产环境务必替换为 32 位以上随机串
DANGO_JWT_SECRET=change-me-to-a-long-random-secret

# 登录 token 有效期（分钟），默认 7 天
DANGO_TOKEN_EXPIRE_MINUTES=10080

# 1=启用 /api/auth/dev-token；0=关闭（关闭后该接口返回 404）
DANGO_DEV_TOKEN=1

# CORS 允许来源，多个用英文逗号分隔；* 表示全部（仅开发环境）
DANGO_CORS_ORIGINS=*

# 开发热重载：1=开启 / 0=关闭
DANGO_RELOAD=0
