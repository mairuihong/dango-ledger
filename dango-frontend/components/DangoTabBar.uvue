<template>
	<view class="tabbar">
		<view class="tabbar-inner">
			<view class="tab-item" :class="{ 'tab-item-active': current === 'home' }" @click="go('/pages/index/index')">
				<image class="tab-icon" :src="current === 'home' ? '/static/tabbar/home-active.png' : '/static/tabbar/home.png'" mode="aspectFit"></image>
				<text class="tab-label" :class="{ 'tab-label-active': current === 'home' }">首页</text>
			</view>

			<view class="tab-item" :class="{ 'tab-item-active': current === 'bills' }" @click="go('/pages/list/list')">
				<image class="tab-icon" :src="current === 'bills' ? '/static/tabbar/bills-active.png' : '/static/tabbar/bills.png'" mode="aspectFit"></image>
				<text class="tab-label" :class="{ 'tab-label-active': current === 'bills' }">账单</text>
			</view>

			<view class="tab-plus-slot"></view>

			<view class="tab-item" :class="{ 'tab-item-active': current === 'stats' }" @click="go('/pages/stats/stats')">
				<image class="tab-icon" :src="current === 'stats' ? '/static/tabbar/report-active.png' : '/static/tabbar/report.png'" mode="aspectFit"></image>
				<text class="tab-label" :class="{ 'tab-label-active': current === 'stats' }">报表</text>
			</view>

			<view class="tab-item" :class="{ 'tab-item-active': current === 'mine' }" @click="go('/pages/mine/mine')">
				<image class="tab-icon" :src="current === 'mine' ? '/static/tabbar/mine-active.png' : '/static/tabbar/mine.png'" mode="aspectFit"></image>
				<text class="tab-label" :class="{ 'tab-label-active': current === 'mine' }">我的</text>
			</view>
		</view>
	</view>

	<view class="tab-plus" @click="goEdit">
		<text class="tab-plus-text">＋</text>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'

	const props = defineProps({
		active: {
			type: String,
			default: 'home'
		}
	})

	const current = computed((): string => props.active)

	function go(url: string): void {
		const pages = getCurrentPages()
		if (pages.length > 0) {
			const route = pages[pages.length - 1].route
			if (route != null && route == url.slice(1)) return
		}
		uni.reLaunch({ url: url })
	}

	function goEdit(): void {
		uni.navigateTo({ url: '/pages/edit/edit' })
	}
</script>

<style>
	.tabbar {
		position: fixed;
		left: 16rpx;
		right: 16rpx;
		bottom: 16rpx;
		z-index: 99;
		background-color: #ffffff;
		border-radius: 40rpx;
		box-shadow: 0 18rpx 50rpx rgba(31, 111, 102, 0.16);
		padding-bottom: env(safe-area-inset-bottom);
		overflow: visible;
	}

	.tabbar-inner {
		position: relative;
		display: flex;
		flex-direction: row;
		align-items: center;
		height: 112rpx;
		overflow: visible;
	}

	.tab-item {
		flex: 1;
		height: 96rpx;
		margin: 8rpx 4rpx;
		border-radius: 28rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.tab-item-active {
		background-color: #e8f7f1;
	}

	.tab-icon {
		width: 44rpx;
		height: 44rpx;
	}

	.tab-label {
		font-size: 20rpx;
		color: #8fa19c;
		margin-top: 4rpx;
	}

	.tab-label-active {
		color: #1f6f66;
		font-weight: 600;
	}

	.tab-plus-slot {
		width: 20%;
		height: 112rpx;
	}

	.tab-plus {
		position: fixed;
		left: 50%;
		bottom: 56rpx;
		margin-left: -56rpx;
		z-index: 100;
		width: 112rpx;
		height: 112rpx;
		border-radius: 56rpx;
		background-color: #2e9e8f;
		background-image: linear-gradient(135deg, #35b4a3, #1f8f82);
		border-width: 8rpx;
		border-style: solid;
		border-color: #edf6f2;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 10rpx 24rpx rgba(31, 111, 102, 0.24);
	}

	.tab-plus-text {
		color: #ffffff;
		font-size: 52rpx;
		font-weight: 300;
		line-height: 52rpx;
		margin-top: -4rpx;
	}
</style>
