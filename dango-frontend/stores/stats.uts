import { ref } from 'vue'
import { defineStore } from 'pinia'
import { api } from '@/services/api.uts'

export const useStatsStore = defineStore('stats', () => {
	const overview = ref<any>(null)
	const trend = ref<any[]>([])
	const incomeItems = ref<any[]>([])
	const incomeTotal = ref(0)
	const loading = ref(false)

	async function loadOverview(month: string): Promise<void> {
		overview.value = await api.stats.overview(month)
	}

	async function loadIncome(month: string): Promise<void> {
		const data = await api.stats.categories(month, 'income')
		incomeItems.value = data.items
		incomeTotal.value = data.total
	}

	async function load(month: string): Promise<void> {
		loading.value = true
		try {
			await loadOverview(month)
			const data = await api.stats.trend(6)
			trend.value = data.items
		} finally {
			loading.value = false
		}
	}

	return { overview, trend, incomeItems, incomeTotal, loading, loadOverview, loadIncome, load }
})
