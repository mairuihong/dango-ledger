<template>
	<view class="page">
		<view v-if="!auth.loggedIn" class="login-wrap">
			<view class="brand">
				<image class="brand-mark" src="/static/icon/dango-mark.png" mode="aspectFit"></image>
				<text class="brand-title">团子账本</text>
				<text class="brand-sub">一口团子，一笔生活</text>
			</view>

			<view class="card login-card">
				<text class="section-title">登录 / 注册</text>
				<text class="tiny login-tip">数据保存在服务端，换设备登录也能看到同一本账。</text>
				<view class="field">
					<text class="field-label">用户名</text>
					<input class="field-input" v-model="username" placeholder="至少 1 位" />
				</view>
				<view class="field">
					<text class="field-label">密码</text>
					<input class="field-input" v-model="password" password placeholder="至少 6 位" />
				</view>
				<button class="btn-primary login-btn" :disabled="busy" @click="login">{{ busy ? '请稍候…' : '登录' }}</button>
				<button class="btn-soft register-btn" :disabled="busy" @click="register">注册新账号</button>
			</view>

			<text class="tiny api-tip">接口地址：{{ apiBase }}</text>
		</view>

		<template v-else>
			<view class="profile">
				<image class="profile-mark" src="/static/icon/dango-mark.png" mode="aspectFit"></image>
				<view class="profile-main">
					<text class="profile-name">{{ auth.user != null ? auth.user.username : '团子用户' }}</text>
					<text class="profile-sub">已登录 · 数据实时同步服务端</text>
				</view>
			</view>

			<view class="card stat-card">
				<view class="stat-item">
					<text class="tiny">本月支出</text>
					<text class="stat-value expense">{{ formatCents(overview.expense) }}</text>
				</view>
				<view class="stat-item">
					<text class="tiny">本月收入</text>
					<text class="stat-value income">{{ formatCents(overview.income) }}</text>
				</view>
				<view class="stat-item">
					<text class="tiny">本月账单</text>
					<text class="stat-value">{{ overview.transaction_count }} 笔</text>
				</view>
			</view>

			<view class="card menu-card">
				<view class="menu-row" @click="goAccounts">
					<view class="icon-circle"><text class="icon-emoji">💰</text></view>
					<view class="menu-main">
						<text class="menu-title">资产账户</text>
						<text class="tiny">银行卡、支付宝、现金和负债</text>
					</view>
					<text class="menu-arrow">›</text>
				</view>
				<view class="menu-row" @click="goCategories">
					<view class="icon-circle"><text class="icon-emoji">🍡</text></view>
					<view class="menu-main">
						<text class="menu-title">分类管理</text>
						<text class="tiny">自定义支出 / 收入分类</text>
					</view>
					<text class="menu-arrow">›</text>
				</view>
				<view class="menu-row" @click="goBudget">
					<view class="icon-circle"><text class="icon-emoji">🎯</text></view>
					<view class="menu-main">
						<text class="menu-title">月度预算</text>
						<text class="tiny">设置本月预算，控制花销</text>
					</view>
					<text class="menu-arrow">›</text>
				</view>
				<view class="menu-row" @click="goCalendar">
					<view class="icon-circle"><text class="icon-emoji">📅</text></view>
					<view class="menu-main">
						<text class="menu-title">账单日历</text>
						<text class="tiny">按天查看收支情况</text>
					</view>
					<text class="menu-arrow">›</text>
				</view>
			</view>

			<view class="card menu-card">
				<view class="menu-row" @click="showAbout">
					<view class="icon-circle"><text class="icon-emoji">🍡</text></view>
					<view class="menu-main">
						<text class="menu-title">关于团子账本</text>
						<text class="tiny">Dango Ledger · v0.1.0</text>
					</view>
					<text class="menu-arrow">›</text>
				</view>
				<view class="menu-row" @click="logout">
					<view class="icon-circle"><text class="icon-emoji">🚪</text></view>
					<view class="menu-main">
						<text class="menu-title">退出登录</text>
						<text class="tiny">token 只保存在内存，退出后需重新登录</text>
					</view>
					<text class="menu-arrow">›</text>
				</view>
			</view>

			<text class="tiny api-tip">接口地址：{{ apiBase }}</text>
		</template>

		<dango-tab-bar active="mine"></dango-tab-bar>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { API_BASE } from '@/config.uts'
	import { useAuthStore } from '@/stores/auth.uts'
	import { useStatsStore } from '@/stores/stats.uts'
	import { formatCents } from '@/utils/money.uts'
	import { localMonth } from '@/utils/date.uts'
	import DangoTabBar from '@/components/DangoTabBar.uvue'

	const auth = useAuthStore()
	const stats = useStatsStore()
	const username = ref('')
	const password = ref('')
	const busy = ref(false)
	const apiBase = API_BASE

	const overview = computed((): any => {
		if (stats.overview == null) {
			return { income: 0, expense: 0, transaction_count: 0 }
		}
		return stats.overview
	})

	onPageShow(() => {
		if (auth.loggedIn) {
			loadStats()
		}
	})

	async function loadStats(): Promise<void> {
		try {
			await stats.loadOverview(localMonth())
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	async function login(): Promise<void> {
		if (busy.value) return
		busy.value = true
		try {
			await auth.login(username.value.trim(), password.value)
			uni.showToast({ title: '登录成功', icon: 'success' })
			await loadStats()
			uni.reLaunch({ url: '/pages/index/index' })
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		} finally {
			busy.value = false
		}
	}

	async function register(): Promise<void> {
		if (busy.value) return
		busy.value = true
		try {
			await auth.register(username.value.trim(), password.value)
			uni.showToast({ title: '注册成功', icon: 'success' })
			await loadStats()
			uni.reLaunch({ url: '/pages/index/index' })
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		} finally {
			busy.value = false
		}
	}

	function logout(): void {
		auth.logout()
		uni.showToast({ title: '已退出', icon: 'none' })
	}

	function goAccounts(): void {
		uni.navigateTo({ url: '/pages/accounts/accounts' })
	}

	function goCategories(): void {
		uni.navigateTo({ url: '/pages/categories/categories' })
	}

	function goBudget(): void {
		uni.reLaunch({ url: '/pages/stats/stats' })
	}

	function goCalendar(): void {
		uni.navigateTo({ url: '/pages/calendar/calendar' })
	}

	function showAbout(): void {
		uni.showModal({
			title: '团子账本 · Dango Ledger',
			content: '在线记账本。所有账单通过接口保存在服务端，前端不落盘；图标是三色团子。',
			showCancel: false
		})
	}
</script>

<style>
	.login-wrap {
		padding-top: 20rpx;
	}

	.brand {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-bottom: 20rpx;
	}

	.brand-mark {
		width: 220rpx;
		height: 220rpx;
	}

	.brand-title {
		font-size: 44rpx;
		font-weight: 700;
		margin-top: 4rpx;
	}

	.brand-sub {
		font-size: 24rpx;
		color: #7b8d88;
		margin-top: 6rpx;
	}

	.login-tip {
		display: block;
		margin-top: 8rpx;
	}

	.field {
		display: flex;
		flex-direction: row;
		align-items: center;
		min-height: 88rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #eef2e9;
	}

	.field-label {
		width: 140rpx;
		color: #6c7766;
		font-size: 26rpx;
	}

	.field-input {
		flex: 1;
		font-size: 26rpx;
	}

	.login-btn {
		margin-top: 24rpx;
	}

	.register-btn {
		margin-top: 14rpx;
	}

	.api-tip {
		display: block;
		text-align: center;
		margin-top: 18rpx;
	}

	.profile {
		position: relative;
		display: flex;
		flex-direction: row;
		align-items: center;
		background-color: #a8ded0;
		background-image: linear-gradient(135deg, #c9efe5, #8fd6c5);
		border-radius: 34rpx;
		padding: 34rpx;
		margin-bottom: 22rpx;
		overflow: hidden;
	}

	.profile-mark {
		width: 130rpx;
		height: 130rpx;
		margin-right: 20rpx;
	}

	.profile-main {
		display: flex;
		flex-direction: column;
	}

	.profile-name {
		font-size: 38rpx;
		font-weight: 700;
		color: #1d2b28;
	}

	.profile-sub {
		font-size: 22rpx;
		color: #1f6f66;
		margin-top: 6rpx;
	}

	.stat-card {
		display: flex;
		flex-direction: row;
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.stat-value {
		font-size: 28rpx;
		font-weight: 600;
		margin-top: 6rpx;
	}

	.menu-card {
		padding-top: 6rpx;
		padding-bottom: 6rpx;
	}

	.menu-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 18rpx 0;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #e8f2ee;
	}

	.menu-main {
		display: flex;
		flex-direction: column;
		flex: 1;
		margin-left: 16rpx;
	}

	.menu-title {
		font-size: 28rpx;
	}

	.menu-arrow {
		color: #b3c4bf;
		font-size: 34rpx;
	}
</style>
