	}

	.amount-range {
		flex: 1;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
	}

	.amount-input {
		width: 160rpx;
		height: 60rpx;
		background-color: #eef7f4;
		border-radius: 999rpx;
		text-align: center;
