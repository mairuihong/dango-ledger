		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-bottom: 20rpx;
		position: relative;
	}

	.month-arrow {
		width: 64rpx;
		height: 64rpx;
		border-radius: 32rpx;
		background-color: #ffffff;
		text-align: center;
		line-height: 58rpx;
		font-size: 40rpx;
		color: #526762;
	}

	.month-center {
		align-items: center;
		margin-left: 20rpx;
		margin-right: 20rpx;
		min-width: 220rpx;
	}

	.month-title {
		font-size: 32rpx;
		font-weight: 600;
	}

