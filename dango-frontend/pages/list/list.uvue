<template>
	<view class="page">
		<view class="month-bar">
			<view class="month-arrow" @click="prevMonth">‹</view>
			<view class="col month-center">
				<text class="month-title">{{ monthTitle(month) }}</text>
				<text class="tiny">月账单</text>
			</view>
			<view class="month-arrow" @click="nextMonth">›</view>
			<text class="calendar-link" @click="goCalendar">日历</text>
		</view>

		<view class="card summary-card">
			<view class="row-between">
				<view class="col">
					<text class="tiny">本月支出</text>
					<text class="summary-expense">{{ formatCents(overview.expense) }}</text>
				</view>
				<view class="col summary-right">
					<text class="tiny">收入 {{ formatCents(overview.income) }}</text>
					<text class="tiny">结余 {{ formatCents(overview.balance) }}</text>
				</view>
			</view>

			<view class="mini-chart">
				<view v-for="bar in bars" :key="bar.day" class="bar-wrap">
					<view class="bar" :style="'height:' + bar.height + 'rpx'"></view>
				</view>
			</view>

			<view class="row-between chart-meta">
				<text class="tiny">日均支出 {{ formatCents(dailyAverage) }}</text>
				<text class="tiny">{{ overview.transaction_count }} 笔</text>
			</view>
		</view>

		<view class="search-row">
			<input class="search-input" v-model="keyword" placeholder="搜索备注、分类、账户" confirm-type="search" @confirm="reload" />
			<text class="search-action" @click="reload">搜索</text>
		</view>

		<view class="filter-bar">
			<scroll-view class="filter-scroll" scroll-x="true">
				<view class="filter-inner">
					<view v-for="item in filters" :key="item.key" class="pill filter-pill" :class="{ 'pill-active': filterType === item.key }" @click="pickType(item.key)">
						{{ item.label }}
					</view>
				</view>
			</scroll-view>
			<text class="filter-toggle" @click="showFilter = !showFilter">筛选{{ activeFilterCount > 0 ? ' · ' + activeFilterCount : '' }}</text>
		</view>

		<view v-if="showFilter" class="card filter-panel">
			<view class="filter-row">
				<text class="filter-label">分类</text>
				<picker :range="categoryFilterNames" :value="categoryFilterIndex" @change="onCategoryFilterChange">
					<view class="filter-value">{{ categoryFilterNames[categoryFilterIndex] }} ›</view>
				</picker>
			</view>
			<view class="filter-row">
				<text class="filter-label">账户</text>
				<picker :range="accountFilterNames" :value="accountFilterIndex" @change="onAccountFilterChange">
					<view class="filter-value">{{ accountFilterNames[accountFilterIndex] }} ›</view>
				</picker>
			</view>
			<view class="filter-row">
				<text class="filter-label">日期</text>
				<view class="date-range">
					<picker mode="date" :value="startDate" @change="onStartDateChange">
						<view class="date-chip">{{ startDate === '' ? '开始' : startDate }}</view>
					</picker>
					<text class="date-sep">至</text>
					<picker mode="date" :value="endDate" @change="onEndDateChange">
						<view class="date-chip">{{ endDate === '' ? '结束' : endDate }}</view>
					</picker>
				</view>
			</view>
			<view class="filter-row">
				<text class="filter-label">金额</text>
				<view class="amount-range">
					<input class="amount-input" v-model="minAmount" type="digit" placeholder="最低" />
					<text class="date-sep">-</text>
					<input class="amount-input" v-model="maxAmount" type="digit" placeholder="最高" />
				</view>
			</view>
			<view class="filter-actions">
				<button class="btn-soft filter-btn" @click="resetFilters">重置</button>
				<button class="btn-primary filter-btn" @click="applyFilters">应用筛选</button>
			</view>
		</view>

		<view v-if="groups.length === 0 && !ledger.loading" class="card empty">
			{{ keyword === '' && activeFilterCount === 0 ? '这个月还没有账单' : '没有找到匹配的账单' }}
		</view>

		<view v-for="group in groups" :key="group.date" class="day-block">
			<view class="day-head">
				<text class="day-label">{{ group.label }}</text>
				<text class="tiny">支 {{ formatCents(group.expense) }} · 收 {{ formatCents(group.income) }}</text>
			</view>
			<view class="card day-card">
				<view v-for="tx in group.items" :key="tx.id" class="tx-row" @click="goEdit(tx.id)" @longpress="confirmDelete(tx)">
					<view class="icon-circle" :class="toneClass(tx)">
						<text class="icon-emoji">{{ iconOf(tx) }}</text>
					</view>
					<view class="tx-main">
						<text class="tx-name">{{ nameOf(tx) }}</text>
						<text class="tiny">{{ noteOf(tx) }}</text>
					</view>
					<view class="tx-right">
						<text class="amount" :class="tx.type === 'income' ? 'income' : (tx.type === 'expense' ? 'expense' : 'muted')">
							{{ amountText(tx) }}
						</text>
						<text class="tiny">{{ tx.account_name }}</text>
					</view>
				</view>
			</view>
		</view>

		<button v-if="ledger.transactions.length < ledger.total" class="btn-soft load-more" :disabled="ledger.loading" @click="loadMore">
			{{ ledger.loading ? '加载中…' : '加载更多' }}
		</button>
		<view v-else-if="ledger.transactions.length > 0" class="tiny bottom-tip">已经到底了</view>

		<dango-tab-bar active="bills"></dango-tab-bar>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { useAuthStore } from '@/stores/auth.uts'
	import { useLedgerStore } from '@/stores/ledger.uts'
	import { useStatsStore } from '@/stores/stats.uts'
	import { formatCents, yuanToCents } from '@/utils/money.uts'
	import { daysInMonth, localDate, localMonth, monthTitle, shiftMonth } from '@/utils/date.uts'
	import DangoTabBar from '@/components/DangoTabBar.uvue'

	const auth = useAuthStore()
	const ledger = useLedgerStore()
	const stats = useStatsStore()
	const month = ref(localMonth())
	const keyword = ref('')
	const filterType = ref('all')
	const showFilter = ref(false)
	const filterCategoryId = ref('')
	const filterAccountId = ref('')
	const categoryFilterIndex = ref(0)
	const accountFilterIndex = ref(0)
	const minAmount = ref('')
	const maxAmount = ref('')
	const startDate = ref('')
	const endDate = ref('')
	const filters = [
		{ key: 'all', label: '全部' },
		{ key: 'expense', label: '支出' },
		{ key: 'income', label: '收入' },
		{ key: 'transfer', label: '转账' }
	]

	const categoryFilterNames = computed((): string[] => {
		const result: string[] = ['全部分类']
		for (let index = 0; index < ledger.categories.length; index++) {
			const item = ledger.categories[index]
			result.push(item.icon + ' ' + item.name)
		}
		return result
	})

	const accountFilterNames = computed((): string[] => {
		const result: string[] = ['全部账户']
		for (let index = 0; index < ledger.accounts.length; index++) {
			result.push(ledger.accounts[index].name)
		}
		return result
	})

	const activeFilterCount = computed((): number => {
		let count = 0
		if (filterType.value != 'all') count++
		if (filterCategoryId.value !== '') count++
		if (filterAccountId.value !== '') count++
		if (minAmount.value.trim() !== '' || maxAmount.value.trim() !== '') count++
		if (startDate.value !== '' || endDate.value !== '') count++
		return count
	})

	const overview = computed((): any => {
		if (stats.overview == null) {
			return { income: 0, expense: 0, balance: 0, transaction_count: 0, daily: [] }
		}
		return stats.overview
	})

	const groups = computed((): any[] => {
		const result: any[] = []
		const today = localDate()
		let currentDate = ''
		let current: any = null
		for (let index = 0; index < ledger.transactions.length; index++) {
			const tx = ledger.transactions[index]
			const date = tx.occurred_at.slice(0, 10)
			if (date != currentDate) {
				currentDate = date
				current = { date: date, label: '', items: [], expense: 0, income: 0 }
				if (date == today) {
					current.label = '今天 ' + date.slice(5, 7) + '月' + date.slice(8, 10) + '日'
				} else {
					current.label = date.slice(5, 7) + '月' + date.slice(8, 10) + '日'
				}
				result.push(current)
			}
			current.items.push(tx)
			if (tx.type == 'expense') current.expense += tx.amount
			if (tx.type == 'income') current.income += tx.amount
		}
		return result
	})

	const dailyAverage = computed((): number => {
		const days = daysInMonth(month.value)
		return days > 0 ? Math.round(overview.value.expense / days) : 0
	})

	const bars = computed((): any[] => {
		const days = daysInMonth(month.value)
		const daily = overview.value.daily as any[]
		const byDay: any[] = []
		let max = 1
		for (let day = 1; day <= days; day++) {
			const date = month.value + (day < 10 ? '-0' : '-') + day.toString()
			let expense = 0
			for (let index = 0; index < daily.length; index++) {
				if (daily[index].date == date) {
					expense = daily[index].expense
					break
				}
			}
			if (expense > max) max = expense
			byDay.push({ day: day, expense: expense })
		}
		const result: any[] = []
		for (let index = 0; index < byDay.length; index++) {
			const expense = byDay[index].expense
			const height = expense > 0 ? Math.round((expense * 76) / max) : 0
			result.push({ day: byDay[index].day, height: height < 6 && height > 0 ? 6 : height })
		}
		return result
	})

	function buildFilters(): any {
		const result: any = {}
		if (filterType.value != 'all') result.type = filterType.value
		if (filterCategoryId.value !== '') result.category_id = filterCategoryId.value
		if (filterAccountId.value !== '') result.account_id = filterAccountId.value
		if (minAmount.value.trim() !== '') result.min_amount = yuanToCents(minAmount.value)
		if (maxAmount.value.trim() !== '') result.max_amount = yuanToCents(maxAmount.value)
		if (startDate.value !== '') result.start_date = startDate.value
		if (endDate.value !== '') result.end_date = endDate.value
		return result
	}

	async function reload(): Promise<void> {
		if (!auth.loggedIn) {
			uni.showToast({ title: '请先登录', icon: 'none' })
			return
		}
		try {
			const filterParams = buildFilters()
			await ledger.loadTransactions(month.value, keyword.value, 1, filterParams)
			await stats.loadOverview(month.value)
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	async function initPage(): Promise<void> {
		try {
			await ledger.loadCategories()
			await ledger.loadAccounts()
			await reload()
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	onPageShow(() => {
		if (auth.loggedIn) {
			initPage()
		}
	})

	function prevMonth(): void {
		month.value = shiftMonth(month.value, -1)
		reload()
	}

	function nextMonth(): void {
		const next = shiftMonth(month.value, 1)
		if (next > localMonth()) return
		month.value = next
		reload()
	}

	function pickType(type: string): void {
		if (type == filterType.value) return
		filterType.value = type
		filterCategoryId.value = ''
		categoryFilterIndex.value = 0
		reload()
	}

	function onCategoryFilterChange(event: any): void {
		const index = Number(event.detail.value)
		categoryFilterIndex.value = index
		if (index == 0) {
			filterCategoryId.value = ''
		} else if (index - 1 < ledger.categories.length) {
			filterCategoryId.value = ledger.categories[index - 1].id
		}
	}

	function onAccountFilterChange(event: any): void {
		const index = Number(event.detail.value)
		accountFilterIndex.value = index
		if (index == 0) {
			filterAccountId.value = ''
		} else if (index - 1 < ledger.accounts.length) {
			filterAccountId.value = ledger.accounts[index - 1].id
		}
	}

	function onStartDateChange(event: any): void {
		startDate.value = event.detail.value.toString()
	}

	function onEndDateChange(event: any): void {
		endDate.value = event.detail.value.toString()
	}

	function applyFilters(): void {
		showFilter.value = false
		reload()
	}

	function resetFilters(): void {
		filterType.value = 'all'
		filterCategoryId.value = ''
		filterAccountId.value = ''
		categoryFilterIndex.value = 0
		accountFilterIndex.value = 0
		minAmount.value = ''
		maxAmount.value = ''
		startDate.value = ''
		endDate.value = ''
		showFilter.value = false
		reload()
	}

	async function loadMore(): Promise<void> {
		try {
			await ledger.loadMore(month.value, keyword.value, buildFilters())
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	function iconOf(tx: any): string {
		if (tx.category_icon != null) return tx.category_icon
		return tx.type == 'transfer' ? '🔁' : '🍡'
	}

	function nameOf(tx: any): string {
		if (tx.type == 'transfer') return '内部转账'
		return tx.category_name != null ? tx.category_name : '未分类'
	}

	function noteOf(tx: any): string {
		if (tx.note != null && tx.note !== '') return tx.note
		return tx.type == 'transfer' ? tx.account_name + ' → ' + tx.to_account_name : tx.account_name
	}

	function amountText(tx: any): string {
		if (tx.type == 'income') return '+' + formatCents(tx.amount)
		if (tx.type == 'expense') return '-' + formatCents(tx.amount)
		return formatCents(tx.amount)
	}

	function toneClass(tx: any): string {
		return tx.type == 'income' ? 'tone-income' : (tx.type == 'transfer' ? 'tone-transfer' : 'tone-expense')
	}

	function goEdit(id: string = ''): void {
		uni.navigateTo({ url: id === '' ? '/pages/edit/edit' : '/pages/edit/edit?id=' + id })
	}

	function goCalendar(): void {
		uni.navigateTo({ url: '/pages/calendar/calendar?month=' + month.value })
	}

	function confirmDelete(tx: any): void {
		uni.showModal({
			title: '删除这笔账单？',
			content: '删除后余额会同步冲销',
			success: (result: any) => {
				if (!result.confirm) return
				removeTransaction(tx.id)
			}
		})
	}

	async function removeTransaction(id: string): Promise<void> {
		try {
			await ledger.removeTransaction(id)
			await reload()
			uni.showToast({ title: '已删除', icon: 'success' })
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}
</script>

<style>
