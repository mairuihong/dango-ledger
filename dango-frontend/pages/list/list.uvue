		padding: 6rpx 8rpx 10rpx;
	}

	.day-label {
		font-size: 24rpx;
		color: #526762;
		font-weight: 600;
	}

	.day-card {
		padding-top: 4rpx;
		padding-bottom: 4rpx;
	}

	.tx-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 16rpx 0;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #e8f2ee;
	}

	.tx-main {
		display: flex;
		flex-direction: column;
		flex: 1;
		margin-left: 16rpx;
	}

	.tx-name {
		font-size: 28rpx;
	}

	.tx-right {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	.load-more {
		margin-top: 18rpx;
	}

	.bottom-tip {
		text-align: center;
		margin-top: 18rpx;
	}

	.tone-expense {
		background-color: #fdeeee;
	}

	.tone-income {
		background-color: #e3f5ee;
	}

	.tone-transfer {
		background-color: #eaf2f7;
	}
</style>
