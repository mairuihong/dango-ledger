		padding-bottom: 24rpx;
	}

	.summary-expense {
		font-size: 48rpx;
		font-weight: 700;
		color: #d96b6b;
		margin-top: 6rpx;
	}

	.summary-right {
		align-items: flex-end;
	}

	.mini-chart {
		display: flex;
		flex-direction: row;
		align-items: flex-end;
		height: 84rpx;
		margin-top: 20rpx;
	}

	.bar-wrap {
		flex: 1;
		display: flex;
		flex-direction: row;
		align-items: flex-end;
		justify-content: center;
		height: 84rpx;
	}

	.bar {
		width: 10rpx;
		background-color: #f2a6b7;
		border-radius: 5rpx;
	}

	.chart-meta {
		margin-top: 10rpx;
	}

	.search-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		background-color: #ffffff;
		border-radius: 999rpx;
		padding-left: 24rpx;
		padding-right: 20rpx;
		height: 76rpx;
		margin-bottom: 16rpx;
	}

	.search-input {
		flex: 1;
		font-size: 26rpx;
	}

	.search-action {
		color: #2e9e8f;
		font-size: 24rpx;
	}

	.filter-bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-bottom: 10rpx;
	}

	.filter-scroll {
		flex: 1;
	}

	.filter-inner {
		display: flex;
		flex-direction: row;
	}

	.filter-pill {
		margin-right: 12rpx;
	}

	.filter-toggle {
		margin-left: 14rpx;
		color: #2e9e8f;
		font-size: 24rpx;
		font-weight: 600;
	}

	.filter-panel {
		padding-top: 8rpx;
		padding-bottom: 24rpx;
	}

	.filter-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		min-height: 84rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #e8f2ee;
	}

	.filter-label {
		width: 100rpx;
		color: #526762;
		font-size: 26rpx;
	}

	.filter-value {
		flex: 1;
		text-align: right;
		font-size: 26rpx;
		color: #1d2b28;
	}

	.date-range {
		flex: 1;
		display: flex;
		flex-direction: row;
