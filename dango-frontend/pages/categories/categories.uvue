<template>
	<view class="page">
		<view class="tabs">
			<view class="tab" :class="{ 'tab-active': kind === 'expense' }" @click="kind = 'expense'">支出分类</view>
			<view class="tab" :class="{ 'tab-active': kind === 'income' }" @click="kind = 'income'">收入分类</view>
		</view>

		<view class="card">
			<view class="row-between">
				<text class="section-title">{{ kind === 'expense' ? '支出分类' : '收入分类' }}</text>
				<text class="tiny">{{ list.length }} 个 · 长按删除自定义</text>
			</view>
			<view v-if="list.length === 0" class="empty">还没有分类</view>
			<view class="cat-grid">
				<view v-for="(item, index) in list" :key="item.id" class="cat-item" @longpress="confirmDelete(item)">
					<view class="cat-icon" :class="toneClass(index)">
						<text class="cat-emoji">{{ item.icon }}</text>
						<view v-if="!item.is_system" class="cat-del" @click.stop="confirmDelete(item)">×</view>
					</view>
					<text class="cat-name">{{ item.name }}</text>
					<text class="cat-flag">{{ item.is_system ? '系统' : '自定义' }}</text>
				</view>
			</view>
		</view>

		<view class="card">
			<text class="section-title">新增{{ kind === 'expense' ? '支出' : '收入' }}分类</text>
			<view class="field">
				<text class="field-label">名称</text>
				<input class="field-input" v-model="name" placeholder="如 咖啡" maxlength="16" />
			</view>
			<view class="field">
				<text class="field-label">图标</text>
				<input class="field-input" v-model="icon" placeholder="emoji，如 ☕" maxlength="4" />
			</view>
			<view class="field">
				<text class="field-label">颜色</text>
				<view class="color-row">
					<view v-for="color in colors" :key="color" class="color-dot" :class="{ 'color-active': selectedColor === color }" :style="'background-color:' + color" @click="selectedColor = color"></view>
				</view>
			</view>
			<button class="btn-primary add-btn" @click="add">添加分类</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { useAuthStore } from '@/stores/auth.uts'
	import { useLedgerStore } from '@/stores/ledger.uts'

	const auth = useAuthStore()
	const ledger = useLedgerStore()
	const kind = ref('expense')
	const name = ref('')
	const icon = ref('')
	const selectedColor = ref('#F2A6B7')
	const colors = ['#F2A6B7', '#F6D68A', '#B4D9A8', '#9DC8E8', '#C9B8E8', '#E8B79D']

	const list = computed((): any[] => {
		const result: any[] = []
		for (let index = 0; index < ledger.categories.length; index++) {
			const item = ledger.categories[index]
			if (item.kind == kind.value) result.push(item)
		}
		return result
	})

	onPageShow(() => {
		load()
	})

	async function load(): Promise<void> {
		if (!auth.loggedIn) return
		try {
			await ledger.loadCategories()
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	function toneClass(index: number): string {
		return 'tone-' + (index % 6).toString()
	}

	async function add(): Promise<void> {
		if (name.value.trim() === '') {
			uni.showToast({ title: '请输入分类名称', icon: 'none' })
			return
		}
		try {
			await ledger.createCategory(name.value.trim(), kind.value, icon.value.trim() === '' ? '🍡' : icon.value.trim(), selectedColor.value)
			name.value = ''
			icon.value = ''
			uni.showToast({ title: '已添加', icon: 'success' })
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	function confirmDelete(item: any): void {
		if (item.is_system) return
		uni.showModal({
			title: '删除分类「' + item.name + '」？',
			content: '使用该分类的账单会显示为未分类',
			success: (result: any) => {
				if (!result.confirm) return
				removeCategory(item.id)
			}
		})
	}

	async function removeCategory(id: string): Promise<void> {
		try {
			await ledger.removeCategory(id)
			uni.showToast({ title: '已删除', icon: 'success' })
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}
</script>

<style>
	.tabs {
		display: flex;
		flex-direction: row;
		background-color: #ffffff;
		border-radius: 999rpx;
		padding: 8rpx;
		margin-bottom: 20rpx;
	}

	.tab {
		flex: 1;
		text-align: center;
		padding: 16rpx 0;
		border-radius: 999rpx;
		font-size: 26rpx;
		color: #6c7766;
	}

	.tab-active {
		background-color: #6f8f63;
		color: #ffffff;
		font-weight: 600;
	}

	.cat-grid {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 12rpx;
	}

	.cat-item {
		width: 25%;
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-top: 20rpx;
	}

	.cat-icon {
		position: relative;
		width: 88rpx;
		height: 88rpx;
		border-radius: 44rpx;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.cat-emoji {
		font-size: 40rpx;
	}

	.cat-del {
		position: absolute;
		right: -4rpx;
		top: -4rpx;
		width: 34rpx;
		height: 34rpx;
		border-radius: 17rpx;
		background-color: #d96b6b;
		color: #ffffff;
		font-size: 24rpx;
		text-align: center;
		line-height: 32rpx;
	}

	.cat-name {
		font-size: 21rpx;
		color: #3f4b39;
		margin-top: 8rpx;
	}

	.cat-flag {
		font-size: 18rpx;
		color: #a5ada0;
		margin-top: 2rpx;
	}

	.tone-0 {
		background-color: #fbe6ea;
	}

	.tone-1 {
		background-color: #f8efd9;
	}

	.tone-2 {
		background-color: #e8f3e1;
	}

	.tone-3 {
		background-color: #e6f0f7;
	}

	.tone-4 {
		background-color: #efeaf7;
	}

	.tone-5 {
		background-color: #f6f0e2;
	}

	.field {
		display: flex;
		flex-direction: row;
		align-items: center;
		min-height: 88rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #eef2e9;
	}

	.field-label {
		width: 120rpx;
		color: #6c7766;
		font-size: 26rpx;
	}

	.field-input {
		flex: 1;
		text-align: right;
		font-size: 26rpx;
	}

	.color-row {
		flex: 1;
		display: flex;
		flex-direction: row;
		justify-content: flex-end;
	}

	.color-dot {
		width: 42rpx;
		height: 42rpx;
		border-radius: 21rpx;
		margin-left: 14rpx;
		border-width: 3rpx;
		border-style: solid;
		border-color: transparent;
	}

	.color-active {
		border-color: #2f3a2c;
	}

	.add-btn {
		margin-top: 22rpx;
	}
</style>
