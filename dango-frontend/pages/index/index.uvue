		margin-top: 10rpx;
	}

	.hero-meta {
		display: flex;
		flex-direction: row;
		margin-top: 26rpx;
		padding-right: 100rpx;
	}

	.hero-meta-item {
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.hero-meta-label {
		color: #4f6a46;
