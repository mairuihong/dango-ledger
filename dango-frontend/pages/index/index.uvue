		font-weight: 600;
		margin-top: 4rpx;
	}

	.budget-track {
		height: 10rpx;
		background-color: #ffffff;
		border-radius: 5rpx;
		margin-top: 22rpx;
		overflow: hidden;
	}

	.budget-fill {
		height: 10rpx;
		background-color: #4f6a46;
		border-radius: 5rpx;
	}

	.login-card {
		padding: 30rpx;
	}

	.login-mark {
		width: 120rpx;
		height: 120rpx;
		margin-right: 20rpx;
	}

	.login-btn {
		margin-top: 24rpx;
	}

	.record-btn {
		height: 96rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-bottom: 22rpx;
	}

	.record-plus {
		font-size: 38rpx;
