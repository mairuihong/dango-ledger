<template>
	<view class="dango-page">
		<view class="hero">
			<text class="hero-label">本月结余</text>
			<text class="hero-amount">{{ formatCents(summary.balance) }}</text>
			<view class="hero-row">
				<view class="hero-item">
					<text class="hero-label">收入</text>
					<text class="hero-value">{{ formatCents(summary.income) }}</text>
				</view>
				<view class="hero-item">
					<text class="hero-label">支出</text>
					<text class="hero-value">{{ formatCents(summary.expense) }}</text>
				</view>
			</view>
		</view>

		<view v-if="!auth.loggedIn" class="dango-card center">
			<text class="dango-muted">登录后开始记账</text>
			<button class="primary" @click="goMine">去登录</button>
		</view>

		<template v-else>
			<view class="dango-card">
				<view class="row-between">
					<text class="dango-title">本月预算</text>
					<text class="dango-muted" @click="goStats">设置</text>
				</view>
				<view class="budget-track">
					<view class="budget-fill" :style="'width:' + budgetPercent + '%'"></view>
				</view>
				<view class="row-between budget-meta">
					<text class="dango-muted">已支出 {{ formatCents(summary.expense) }}</text>
					<text class="dango-muted">{{ budget.amount > 0 ? '预算 ' + formatCents(budget.amount) : '未设置' }}</text>
				</view>
			</view>

			<view class="quick">
				<view class="quick-item" @click="goEdit">
					<text class="quick-icon">＋</text>
					<text class="quick-text">记一笔</text>
				</view>
				<view class="quick-item" @click="goAccounts">
					<text class="quick-icon">￥</text>
					<text class="quick-text">账户</text>
				</view>
				<view class="quick-item" @click="goCategories">
					<text class="quick-icon">☰</text>
					<text class="quick-text">分类</text>
				</view>
			</view>

			<view class="dango-card">
				<view class="row-between">
					<text class="dango-title">最近记录</text>
					<text class="dango-muted" @click="goList">全部</text>
				</view>
				<view v-if="recent.length === 0" class="empty">还没有记录，先记一笔吧</view>
				<view v-for="tx in recent" :key="tx.id" class="tx-row">
					<view class="tx-main">
						<text class="tx-title">{{ tx.category_name != null ? tx.category_name : (tx.type == 'transfer' ? '转账' : '未分类') }}</text>
						<text class="dango-muted">{{ tx.occurred_at.slice(0, 10) }} {{ tx.note }}</text>
					</view>
					<text :class="amountClass(tx)">{{ amountText(tx) }}</text>
				</view>
			</view>
		</template>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import { useAuthStore } from '@/stores/auth.uts'
	import { useLedgerStore } from '@/stores/ledger.uts'
	import { useStatsStore } from '@/stores/stats.uts'
	import { useBudgetStore } from '@/stores/budget.uts'
	import { formatCents } from '@/utils/money.uts'
	import { localMonth } from '@/utils/date.uts'

	const auth = useAuthStore()
	const ledger = useLedgerStore()
	const stats = useStatsStore()
	const budget = useBudgetStore()
	const month = localMonth()

	const summary = computed((): any => {
		if (stats.overview == null) {
			return { income: 0, expense: 0, balance: 0 }
		}
		return stats.overview
	})

	const budgetPercent = computed((): number => {
		if (budget.amount <= 0) return 0
		const percent = Math.round((summary.value.expense * 100) / budget.amount)
		return percent > 100 ? 100 : percent
	})

	const recent = computed((): any[] => {
		const result: any[] = []
		const size = ledger.transactions.length < 5 ? ledger.transactions.length : 5
		for (let index = 0; index < size; index++) {
			result.push(ledger.transactions[index])
		}
		return result
	})

	async function load(): Promise<void> {
		if (!auth.loggedIn) return
		try {
			await ledger.loadAccounts()
			await ledger.loadCategories()
			await ledger.loadTransactions(month, '', 1)
			await stats.load(month)
			await budget.load(month)
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	onPageShow(() => {
		load()
	})

	function amountText(tx: any): string {
		const sign = tx.type == 'income' ? '+' : '-'
		return sign + formatCents(tx.amount)
	}

	function amountClass(tx: any): string {
		return tx.type == 'income' ? 'tx-amount dango-income' : 'tx-amount dango-expense'
	}

	function goEdit(): void {
		uni.navigateTo({ url: '/pages/edit/edit' })
	}

	function goList(): void {
		uni.switchTab({ url: '/pages/list/list' })
	}

	function goStats(): void {
		uni.switchTab({ url: '/pages/stats/stats' })
	}

	function goMine(): void {
		uni.switchTab({ url: '/pages/mine/mine' })
	}

	function goAccounts(): void {
		uni.navigateTo({ url: '/pages/accounts/accounts' })
	}

	function goCategories(): void {
		uni.navigateTo({ url: '/pages/categories/categories' })
	}
</script>

<style>
	.hero {
		background-color: #ff8a65;
		border-radius: 24rpx;
		padding: 40rpx;
		margin-bottom: 24rpx;
	}

	.hero-label {
		color: #fff7f3;
		font-size: 24rpx;
	}

	.hero-amount {
		display: block;
		color: #ffffff;
		font-size: 64rpx;
		font-weight: 700;
		margin-top: 8rpx;
	}

	.hero-row {
		display: flex;
		flex-direction: row;
		margin-top: 28rpx;
	}

	.hero-item {
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.hero-value {
		color: #ffffff;
		font-size: 30rpx;
		font-weight: 600;
		margin-top: 6rpx;
	}

	.center {
		align-items: center;
	}

	.row-between {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}

	.budget-track {
		height: 16rpx;
		background-color: #f2f3f5;
		border-radius: 8rpx;
		margin-top: 20rpx;
		overflow: hidden;
	}

	.budget-fill {
		height: 16rpx;
		background-color: #ff8a65;
		border-radius: 8rpx;
	}

	.budget-meta {
		margin-top: 12rpx;
	}

	.quick {
		display: flex;
		flex-direction: row;
		background-color: #ffffff;
		border-radius: 20rpx;
		padding: 20rpx 0;
		margin-bottom: 24rpx;
	}

	.quick-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		flex: 1;
	}

	.quick-icon {
		font-size: 40rpx;
		color: #ff8a65;
	}

	.quick-text {
		font-size: 24rpx;
		margin-top: 6rpx;
	}

	.tx-row {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 18rpx 0;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f2f3f5;
	}

	.tx-main {
		display: flex;
		flex-direction: column;
	}

	.tx-title {
		font-size: 28rpx;
	}

	.tx-amount {
		font-size: 30rpx;
		font-weight: 600;
	}

	.empty {
		padding: 40rpx 0;
		text-align: center;
		color: #909399;
		font-size: 26rpx;
	}

	.primary {
		margin-top: 20rpx;
		background-color: #ff8a65;
		color: #ffffff;
		border-radius: 12rpx;
		font-size: 28rpx;
	}
</style>
