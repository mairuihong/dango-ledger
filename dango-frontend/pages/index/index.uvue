		position: relative;
		background-color: #a9c89b;
		border-radius: 34rpx;
		padding: 32rpx;
		margin-bottom: 24rpx;
		overflow: hidden;
	}

	.hero-mark {
		position: absolute;
		right: -36rpx;
		top: 6rpx;
		width: 300rpx;
		height: 300rpx;
		opacity: 0.9;
	}

	.hero-copy {
		position: relative;
		z-index: 2;
	}

	.hero-top {
		padding-right: 150rpx;
	}

