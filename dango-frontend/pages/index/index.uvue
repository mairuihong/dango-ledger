	}

	.quick-grid {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		background-color: #ffffff;
		border-radius: 28rpx;
		padding: 24rpx 12rpx;
		margin-bottom: 22rpx;
		border-width: 1rpx;
		border-style: solid;
		border-color: #edf2e7;
	}

	.quick-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		flex: 1;
	}

	.quick-icon {
		width: 76rpx;
		height: 76rpx;
		border-radius: 38rpx;
		background-color: #f1f6ec;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.quick-text {
		font-size: 23rpx;
		color: #5f6b59;
		margin-top: 10rpx;
	}

	.day-group {
		margin-top: 20rpx;
	}

	.day-head {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 8rpx;
	}

	.day-label {
		font-size: 24rpx;
		color: #5f6b59;
		font-weight: 600;
	}

	.tx-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 16rpx 0;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f1f5ec;
	}

	.tx-main {
		display: flex;
		flex-direction: column;
		flex: 1;
		margin-left: 16rpx;
	}

	.tx-name {
		font-size: 28rpx;
		color: #2f3a2c;
	}

	.tone-expense {
		background-color: #fcecec;
	}

	.tone-income {
		background-color: #eaf4e5;
	}

	.tone-transfer {
		background-color: #eef2f8;
	}
</style>
