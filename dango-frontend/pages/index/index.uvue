<template>
	<view class="page">
		<view class="hero">
			<image class="hero-mark" src="/static/icon/dango-mark.png" mode="aspectFit"></image>
			<view class="hero-copy">
				<view class="row-between hero-top">
					<text class="hero-eyebrow">{{ greeting }} · {{ month }} 支出</text>
					<text class="hero-month" @click="goList">明细 ›</text>
				</view>
				<text class="hero-amount">{{ formatCents(summary.expense) }}</text>
				<view class="hero-meta">
					<view class="hero-meta-item">
						<text class="hero-meta-label">收入</text>
						<text class="hero-meta-value">{{ formatCents(summary.income) }}</text>
					</view>
					<view class="hero-meta-item">
						<text class="hero-meta-label">结余</text>
						<text class="hero-meta-value">{{ formatCents(summary.balance) }}</text>
					</view>
					<view class="hero-meta-item">
						<text class="hero-meta-label">预算剩余</text>
						<text class="hero-meta-value">{{ budget.amount > 0 ? formatCents(budgetLeft) : '未设置' }}</text>
					</view>
				</view>
				<view class="budget-track">
					<view class="budget-fill" :style="'width:' + budgetPercent + '%'"></view>
				</view>
			</view>
		</view>

		<view v-if="!auth.loggedIn" class="card login-card">
			<view class="row">
				<image class="login-mark" src="/static/icon/dango-mark.png" mode="aspectFit"></image>
				<view class="col flex1">
					<text class="title">欢迎来到团子账本</text>
					<text class="muted">登录后，账单会保存在服务端，换设备也能看到同一本账。</text>
				</view>
			</view>
			<button class="btn-primary login-btn" @click="goMine">登录 / 注册</button>
		</view>

		<template v-else>
			<button class="btn-primary record-btn" @click="goEdit('')">
				<text class="record-plus">＋</text>
				<text>记一笔</text>
			</button>

			<view class="quick-grid">
				<view class="quick-item" @click="goCalendar">
					<view class="quick-icon"><text class="icon-emoji">📅</text></view>
					<text class="quick-text">日历</text>
				</view>
				<view class="quick-item" @click="goAccounts">
					<view class="quick-icon"><text class="icon-emoji">💰</text></view>
					<text class="quick-text">资产</text>
				</view>
				<view class="quick-item" @click="goStats">
					<view class="quick-icon"><text class="icon-emoji">📊</text></view>
					<text class="quick-text">报表</text>
				</view>
				<view class="quick-item" @click="goCategories">
					<view class="quick-icon"><text class="icon-emoji">🍡</text></view>
					<text class="quick-text">分类</text>
				</view>
			</view>

			<view class="card">
				<view class="row-between">
					<text class="section-title">最近账单</text>
					<text class="muted" @click="goList">全部 ›</text>
				</view>
				<view v-if="groups.length === 0" class="empty">还没有账单，点上面「记一笔」开始</view>
				<view v-for="group in groups" :key="group.date" class="day-group">
					<view class="day-head">
						<text class="day-label">{{ group.label }}</text>
						<text class="tiny">支 {{ formatCents(group.expense) }} · 收 {{ formatCents(group.income) }}</text>
					</view>
					<view v-for="tx in group.items" :key="tx.id" class="tx-row" @click="goEdit(tx.id)">
						<view class="icon-circle" :class="toneClass(tx)">
							<text class="icon-emoji">{{ iconOf(tx) }}</text>
						</view>
						<view class="tx-main">
							<text class="tx-name">{{ nameOf(tx) }}</text>
							<text class="tiny">{{ noteOf(tx) }}</text>
						</view>
						<text class="amount" :class="tx.type === 'income' ? 'income' : (tx.type === 'expense' ? 'expense' : 'muted')">
							{{ amountText(tx) }}
						</text>
					</view>
				</view>
			</view>
		</template>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import { useAuthStore } from '@/stores/auth.uts'
	import { useLedgerStore } from '@/stores/ledger.uts'
	import { useStatsStore } from '@/stores/stats.uts'
	import { useBudgetStore } from '@/stores/budget.uts'
	import { formatCents } from '@/utils/money.uts'
	import { localDate, localMonth } from '@/utils/date.uts'

	const auth = useAuthStore()
	const ledger = useLedgerStore()
	const stats = useStatsStore()
	const budget = useBudgetStore()
	const month = localMonth()

	const summary = computed((): any => {
		if (stats.overview == null) {
			return { income: 0, expense: 0, balance: 0 }
		}
		return stats.overview
	})

	const budgetLeft = computed((): number => budget.amount - summary.value.expense)

	const budgetPercent = computed((): number => {
		if (budget.amount <= 0) return 0
		const percent = Math.round((summary.value.expense * 100) / budget.amount)
		return percent > 100 ? 100 : percent
	})

	const greeting = computed((): string => {
		const hour = new Date().getHours()
		if (hour < 11) return '早上好'
		if (hour < 18) return '下午好'
		return '晚上好'
	})

	const groups = computed((): any[] => {
		const result: any[] = []
		const today = localDate()
		const yesterday = localDate(new Date(new Date().getTime() - 86400000))
		let currentDate = ''
		let current: any = null
		for (let index = 0; index < ledger.transactions.length; index++) {
			const tx = ledger.transactions[index]
			const date = tx.occurred_at.slice(0, 10)
			if (date != currentDate) {
				if (result.length >= 3) break
				currentDate = date
				current = { date: date, label: '', items: [], expense: 0, income: 0 }
				if (date == today) {
					current.label = '今天'
				} else if (date == yesterday) {
					current.label = '昨天'
				} else {
					current.label = date.slice(5, 7) + '月' + date.slice(8, 10) + '日'
				}
				result.push(current)
			}
			if (current != null) {
				current.items.push(tx)
				if (tx.type == 'expense') current.expense += tx.amount
				if (tx.type == 'income') current.income += tx.amount
			}
		}
		return result
	})

	async function load(): Promise<void> {
		if (!auth.loggedIn) return
		try {
			await ledger.loadAccounts()
			await ledger.loadCategories()
			await ledger.loadTransactions(month, '', 1)
			await stats.loadOverview(month)
			await budget.load(month)
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	onPageShow(() => {
		load()
	})

	function iconOf(tx: any): string {
		if (tx.category_icon != null) return tx.category_icon
		return tx.type == 'transfer' ? '🔁' : '🍡'
	}

	function nameOf(tx: any): string {
		if (tx.type == 'transfer') return '内部转账'
		return tx.category_name != null ? tx.category_name : '未分类'
	}

	function noteOf(tx: any): string {
		if (tx.type == 'transfer') {
			if (tx.note != null && tx.note !== '') return tx.note
			return tx.account_name + ' → ' + (tx.to_account_name != null ? tx.to_account_name : '')
		}
		const note = tx.note != null && tx.note !== '' ? tx.note : tx.account_name
		return note != null ? note : ''
	}

	function amountText(tx: any): string {
		if (tx.type == 'income') return '+' + formatCents(tx.amount)
		if (tx.type == 'expense') return '-' + formatCents(tx.amount)
		return formatCents(tx.amount)
	}

	function toneClass(tx: any): string {
		return tx.type == 'income' ? 'tone-income' : (tx.type == 'transfer' ? 'tone-transfer' : 'tone-expense')
	}

	function goEdit(id: string = ''): void {
		uni.navigateTo({ url: id === '' ? '/pages/edit/edit' : '/pages/edit/edit?id=' + id })
	}

	function goList(): void {
		uni.switchTab({ url: '/pages/list/list' })
	}

	function goStats(): void {
		uni.switchTab({ url: '/pages/stats/stats' })
	}

	function goMine(): void {
		uni.switchTab({ url: '/pages/mine/mine' })
	}

	function goAccounts(): void {
		uni.navigateTo({ url: '/pages/accounts/accounts' })
	}

	function goCategories(): void {
		uni.navigateTo({ url: '/pages/categories/categories' })
	}

	function goCalendar(): void {
		uni.navigateTo({ url: '/pages/calendar/calendar' })
	}
</script>

