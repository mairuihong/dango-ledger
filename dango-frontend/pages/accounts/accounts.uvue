<template>
	<view class="page">
		<view class="asset-hero">
			<text class="asset-label">净资产</text>
			<text class="asset-total">{{ formatCents(ledger.totalBalance) }}</text>
			<view class="asset-meta">
				<view class="asset-meta-item">
					<text class="asset-meta-label">总资产</text>
					<text class="asset-meta-value">{{ formatCents(assets) }}</text>
				</view>
				<view class="asset-meta-item">
					<text class="asset-meta-label">总负债</text>
					<text class="asset-meta-value">{{ formatCents(liabilities) }}</text>
				</view>
			</view>
			<image class="asset-mark" src="/static/icon/dango-mark.png" mode="aspectFit"></image>
		</view>

		<button class="btn-primary add-btn" @click="toggleForm">{{ showForm ? '收起' : '添加资产' }}</button>

		<view v-if="showForm" class="card form-card">
			<text class="section-title">{{ editingId === '' ? '添加资产' : '编辑资产' }}</text>
			<view class="field">
				<text class="field-label">名称</text>
				<input class="field-input" v-model="name" placeholder="如 招商银行卡" />
			</view>
			<view v-if="editingId === ''" class="field">
				<text class="field-label">类型</text>
				<picker :range="typeLabels" :value="typeIndex" @change="onTypeChange">
					<view class="field-value">{{ typeLabels[typeIndex] }} ›</view>
				</picker>
			</view>
			<view class="field">
				<text class="field-label">初始余额</text>
				<input class="field-input" v-model="initial" type="digit" placeholder="0.00，负债填负数" />
			</view>
			<view class="form-actions">
				<button class="btn-soft form-btn" @click="cancelEdit">取消</button>
				<button class="btn-primary form-btn" @click="submitForm">{{ editingId === '' ? '添加' : '保存' }}</button>
			</view>
			<text v-if="editingId !== ''" class="delete-link" @click="confirmDelete">删除这个资产</text>
		</view>

		<view class="card">
			<view class="row-between">
				<text class="section-title">我的资产</text>
				<text class="tiny">{{ ledger.accounts.length }} 个账户</text>
			</view>
			<view v-if="ledger.accounts.length === 0" class="empty">还没有资产，点上面「添加资产」</view>
			<view v-for="account in ledger.accounts" :key="account.id" class="account-row" @click="startEdit(account)">
				<view class="icon-circle account-icon">
					<text class="icon-emoji">{{ iconOf(account) }}</text>
				</view>
				<view class="account-main">
					<text class="account-name">{{ account.name }}</text>
					<text class="tiny">{{ typeLabel(account.type) }}</text>
				</view>
				<view class="account-right">
					<text class="amount" :class="account.balance < 0 ? 'expense' : ''">{{ formatCents(account.balance) }}</text>
					<text class="tiny">编辑 ›</text>
				</view>
			</view>
		</view>

		<view class="card recalc-card" @click="recalc">
			<text class="section-title">按流水重算余额</text>
			<text class="tiny">如果余额和账单对不上，可以点这里让服务端重新计算</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { useAuthStore } from '@/stores/auth.uts'
	import { useLedgerStore } from '@/stores/ledger.uts'
	import { formatCents, yuanToCents } from '@/utils/money.uts'

	const auth = useAuthStore()
	const ledger = useLedgerStore()
	const typeLabels = ['现金', '储蓄卡', '银行卡', '信用卡', '支付宝', '微信']
	const typeValues = ['cash', 'card', 'bank', 'credit', 'alipay', 'wechat']
	const typeIndex = ref(0)
	const name = ref('')
	const initial = ref('')
	const showForm = ref(false)
	const editingId = ref('')

	const assets = computed((): number => {
		let total = 0
		for (let index = 0; index < ledger.accounts.length; index++) {
			if (ledger.accounts[index].balance > 0) total += ledger.accounts[index].balance
		}
		return total
	})

	const liabilities = computed((): number => {
		let total = 0
		for (let index = 0; index < ledger.accounts.length; index++) {
			if (ledger.accounts[index].balance < 0) total += -ledger.accounts[index].balance
		}
		return total
	})

	onPageShow(() => {
		load()
	})

	async function load(): Promise<void> {
		if (!auth.loggedIn) return
		try {
			await ledger.loadAccounts()
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	function toggleForm(): void {
		showForm.value = !showForm.value
		if (!showForm.value) cancelEdit()
	}

	function onTypeChange(event: any): void {
		typeIndex.value = Number(event.detail.value)
	}

	function typeLabel(type: string): string {
		for (let index = 0; index < typeValues.length; index++) {
			if (typeValues[index] == type) return typeLabels[index]
		}
		return type
	}

	function iconOf(account: any): string {
		if (account.type == 'cash') return '💵'
		if (account.type == 'credit') return '💳'
		if (account.type == 'bank') return '🏦'
		if (account.type == 'alipay') return '🔵'
		if (account.type == 'wechat') return '🟢'
		return '💳'
	}

	function startEdit(account: any): void {
		editingId.value = account.id
		name.value = account.name
		initial.value = (account.initial_balance / 100).toFixed(2)
		for (let index = 0; index < typeValues.length; index++) {
			if (typeValues[index] == account.type) typeIndex.value = index
		}
		showForm.value = true
	}

	function cancelEdit(): void {
		editingId.value = ''
		name.value = ''
		initial.value = ''
		showForm.value = false
	}

	async function submitForm(): Promise<void> {
		if (name.value.trim() === '') {
			uni.showToast({ title: '请输入资产名称', icon: 'none' })
			return
		}
		try {
			const cents = initial.value.trim() === '' ? 0 : yuanToCents(initial.value)
			if (editingId.value === '') {
				await ledger.createAccount(name.value.trim(), typeValues[typeIndex.value], cents)
				uni.showToast({ title: '已添加', icon: 'success' })
			} else {
				await ledger.updateAccount(editingId.value, { name: name.value.trim(), initial_balance: cents })
				uni.showToast({ title: '已保存', icon: 'success' })
			}
			cancelEdit()
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	function confirmDelete(): void {
		uni.showModal({
			title: '删除这个资产？',
			content: '有流水时服务端会拒绝删除',
			success: (result: any) => {
				if (!result.confirm) return
				removeAccount()
			}
		})
	}

	async function removeAccount(): Promise<void> {
		try {
			await ledger.removeAccount(editingId.value)
			uni.showToast({ title: '已删除', icon: 'success' })
			cancelEdit()
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	async function recalc(): Promise<void> {
		try {
			await ledger.recalcAccounts()
			uni.showToast({ title: '已重算', icon: 'success' })
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}
</script>

<style>
	.asset-hero {
		position: relative;
		background-color: #a9c89b;
		border-radius: 34rpx;
		padding: 32rpx;
		margin-bottom: 22rpx;
		overflow: hidden;
	}

	.asset-label {
		color: #4f6a46;
		font-size: 24rpx;
	}

	.asset-total {
		display: block;
		color: #2f3a2c;
		font-size: 56rpx;
		font-weight: 700;
		margin-top: 6rpx;
	}

	.asset-meta {
		display: flex;
		flex-direction: row;
		margin-top: 20rpx;
		padding-right: 120rpx;
	}

	.asset-meta-item {
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.asset-meta-label {
		color: #4f6a46;
		font-size: 21rpx;
	}

	.asset-meta-value {
		color: #2f3a2c;
		font-size: 24rpx;
		font-weight: 600;
		margin-top: 4rpx;
	}

	.asset-mark {
		position: absolute;
		right: -20rpx;
		bottom: -46rpx;
		width: 240rpx;
		height: 240rpx;
		opacity: 0.8;
	}

	.add-btn {
		height: 88rpx;
		margin-bottom: 20rpx;
	}

	.field {
		display: flex;
		flex-direction: row;
		align-items: center;
		min-height: 88rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #eef2e9;
	}

	.field-label {
		width: 160rpx;
		color: #6c7766;
		font-size: 26rpx;
	}

	.field-input {
		flex: 1;
		text-align: right;
		font-size: 26rpx;
	}

	.field-value {
		text-align: right;
		font-size: 26rpx;
		color: #2f3a2c;
	}

	.form-actions {
		display: flex;
		flex-direction: row;
		margin-top: 22rpx;
	}

	.form-btn {
		flex: 1;
		height: 76rpx;
		font-size: 26rpx;
	}

	.form-btn {
		margin-left: 12rpx;
	}

	.delete-link {
		display: block;
		text-align: center;
		color: #d96b6b;
		font-size: 24rpx;
		margin-top: 22rpx;
	}

	.account-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 18rpx 0;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f1f5ec;
	}

	.account-icon {
		background-color: #f1f6ec;
	}

	.account-main {
		display: flex;
		flex-direction: column;
		flex: 1;
		margin-left: 16rpx;
	}

	.account-name {
		font-size: 28rpx;
	}

	.account-right {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	.recalc-card {
		display: flex;
		flex-direction: column;
	}

	.recalc-card .tiny {
		margin-top: 6rpx;
	}
</style>
