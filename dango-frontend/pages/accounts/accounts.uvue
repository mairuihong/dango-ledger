<template>
	<view class="dango-page">
		<view class="dango-card total-card">
			<text class="dango-muted">总资产</text>
			<text class="total">{{ formatCents(ledger.totalBalance) }}</text>
			<button class="recalc" size="mini" @click="recalc">按流水重算</button>
		</view>

		<view class="dango-card">
			<text class="dango-title">添加账户</text>
			<view class="field">
				<text class="label">名称</text>
				<input class="input" v-model="name" placeholder="如 微信零钱" />
			</view>
			<view class="field">
				<text class="label">类型</text>
				<picker :range="typeLabels" :value="typeIndex" @change="onTypeChange">
					<view class="picker">{{ typeLabels[typeIndex] }}</view>
				</picker>
			</view>
			<view class="field">
				<text class="label">初始余额</text>
				<input class="input" v-model="initial" type="digit" placeholder="0.00" />
			</view>
			<button class="primary" @click="add">添加</button>
		</view>

		<view v-for="account in ledger.accounts" :key="account.id" class="dango-card account-row">
			<view class="account-main">
				<text class="account-name">{{ account.name }}</text>
				<text class="dango-muted">{{ account.type }} · 初始 {{ formatCents(account.initial_balance) }}</text>
			</view>
			<view class="account-right">
				<text class="account-balance">{{ formatCents(account.balance) }}</text>
				<text class="delete" @click="confirmDelete(account)">删除</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { useAuthStore } from '@/stores/auth.uts'
	import { useLedgerStore } from '@/stores/ledger.uts'
	import { formatCents, yuanToCents } from '@/utils/money.uts'

	const auth = useAuthStore()
	const ledger = useLedgerStore()
	const typeLabels = ['现金', '储蓄卡', '银行卡', '信用卡']
	const typeValues = ['cash', 'card', 'bank', 'credit']
	const typeIndex = ref(0)
	const name = ref('')
	const initial = ref('')

	onPageShow(() => {
		load()
	})

	async function load(): Promise<void> {
		if (!auth.loggedIn) return
		try {
			await ledger.loadAccounts()
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	function onTypeChange(event: any): void {
		typeIndex.value = Number(event.detail.value)
	}

	async function add(): Promise<void> {
		if (name.value.trim() === '') {
			uni.showToast({ title: '请输入账户名称', icon: 'none' })
			return
		}
		try {
			const cents = initial.value.trim() === '' ? 0 : yuanToCents(initial.value)
			await ledger.createAccount(name.value.trim(), typeValues[typeIndex.value], cents)
			name.value = ''
			initial.value = ''
			uni.showToast({ title: '已添加', icon: 'success' })
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	function confirmDelete(account: any): void {
		uni.showModal({
			title: '删除账户？',
			content: '账户还有流水时会被服务端拒绝',
			success: (result: any) => {
				if (!result.confirm) return
				deleteAccount(account.id)
			}
		})
	}

	async function deleteAccount(id: string): Promise<void> {
		try {
			await ledger.removeAccount(id)
			uni.showToast({ title: '已删除', icon: 'success' })
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	async function recalc(): Promise<void> {
		try {
			await ledger.recalcAccounts()
			uni.showToast({ title: '已重算', icon: 'success' })
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}
</script>

<style>
	.total-card {
		display: flex;
		flex-direction: column;
	}

	.total {
		font-size: 52rpx;
		font-weight: 700;
		margin-top: 8rpx;
	}

	.recalc {
		margin-top: 16rpx;
		background-color: #fff7f3;
		color: #ff8a65;
		align-self: flex-start;
	}

	.field {
		display: flex;
		flex-direction: row;
		align-items: center;
		min-height: 92rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f2f3f5;
	}

	.label {
		width: 160rpx;
		color: #606266;
		font-size: 28rpx;
	}

	.input {
		flex: 1;
		text-align: right;
		font-size: 28rpx;
	}

	.picker {
		flex: 1;
		text-align: right;
		font-size: 28rpx;
	}

	.primary {
		margin-top: 24rpx;
		background-color: #ff8a65;
		color: #ffffff;
		border-radius: 12rpx;
	}

	.account-row {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}

	.account-main {
		display: flex;
		flex-direction: column;
	}

	.account-name {
		font-size: 30rpx;
	}

	.account-right {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	.account-balance {
		font-size: 30rpx;
		font-weight: 600;
	}

	.delete {
		color: #f56c6c;
		font-size: 24rpx;
		margin-top: 8rpx;
	}
</style>
