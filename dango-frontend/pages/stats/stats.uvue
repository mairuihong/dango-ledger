<template>
	<view class="dango-page">
		<view class="dango-card summary">
			<view class="stat">
				<text class="dango-muted">收入</text>
				<text class="stat-value dango-income">{{ formatCents(data.income) }}</text>
			</view>
			<view class="stat">
				<text class="dango-muted">支出</text>
				<text class="stat-value dango-expense">{{ formatCents(data.expense) }}</text>
			</view>
			<view class="stat">
				<text class="dango-muted">结余</text>
				<text class="stat-value">{{ formatCents(data.balance) }}</text>
			</view>
		</view>

		<view class="dango-card">
			<view class="row-between">
				<text class="dango-title">本月预算</text>
				<text class="dango-muted">已支出 {{ formatCents(data.expense) }}</text>
			</view>
			<view class="field">
				<text class="label">预算金额</text>
				<input class="input" v-model="budgetInput" type="digit" placeholder="0.00" />
			</view>
			<button class="primary" @click="saveBudget">保存预算</button>
			<view class="budget-track">
				<view class="budget-fill" :style="'width:' + budgetPercent + '%'"></view>
			</view>
			<text class="dango-muted">{{ budget.amount > 0 ? '已用 ' + budgetPercent + '%' : '未设置预算' }}</text>
		</view>

		<view class="dango-card">
			<text class="dango-title">{{ month }} 分类支出</text>
			<view v-if="data.categories.length === 0" class="empty">本月暂无支出</view>
			<view v-for="item in data.categories" :key="item.category_id" class="bar-row">
				<text class="bar-name">{{ item.icon }} {{ item.name }}</text>
				<view class="bar-track">
					<view class="bar-fill" :style="'width:' + item.percent + '%'"></view>
				</view>
				<text class="bar-amount">{{ formatCents(item.amount) }}</text>
			</view>
		</view>

		<view class="dango-card">
			<text class="dango-title">近 6 个月支出</text>
			<view class="trend">
				<view v-for="item in trend" :key="item.month" class="trend-col">
					<view class="trend-bar" :style="'height:' + barHeight(item.expense) + 'px'"></view>
					<text class="dango-muted">{{ item.month.slice(5) }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { useAuthStore } from '@/stores/auth.uts'
	import { useStatsStore } from '@/stores/stats.uts'
	import { useBudgetStore } from '@/stores/budget.uts'
	import { formatCents, yuanToCents } from '@/utils/money.uts'
	import { localMonth } from '@/utils/date.uts'

	const auth = useAuthStore()
	const stats = useStatsStore()
	const budget = useBudgetStore()
	const month = localMonth()
	const budgetInput = ref('')

	const data = computed((): any => {
		if (stats.overview == null) {
			return { income: 0, expense: 0, balance: 0, categories: [] }
		}
		return stats.overview
	})

	const trend = computed((): any[] => stats.trend)

	const budgetPercent = computed((): number => {
		if (budget.amount <= 0) return 0
		const percent = Math.round((data.value.expense * 100) / budget.amount)
		return percent > 100 ? 100 : percent
	})

	onPageShow(() => {
		load()
	})

	async function load(): Promise<void> {
		if (!auth.loggedIn) return
		try {
			await stats.load(month)
			await budget.load(month)
			budgetInput.value = budget.amount > 0 ? (budget.amount / 100).toFixed(2) : ''
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	async function saveBudget(): Promise<void> {
		try {
			const cents = budgetInput.value.trim() === '' ? 0 : yuanToCents(budgetInput.value)
			await budget.save(month, cents)
			uni.showToast({ title: '预算已保存', icon: 'success' })
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	function barHeight(amount: number): number {
		let max = 1
		for (let index = 0; index < trend.value.length; index++) {
			if (trend.value[index].expense > max) max = trend.value[index].expense
		}
		const height = Math.round((amount * 120) / max)
		return height < 6 ? 6 : height
	}
</script>

<style>
	.summary {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
	}

	.stat {
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.stat-value {
		font-size: 30rpx;
		font-weight: 700;
		margin-top: 8rpx;
	}

	.row-between {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
	}

	.field {
		display: flex;
		flex-direction: row;
		align-items: center;
		min-height: 88rpx;
		border-bottom-width: 1rpx;
		border-bottom-style: solid;
		border-bottom-color: #f2f3f5;
	}

	.label {
		width: 160rpx;
		color: #606266;
		font-size: 28rpx;
	}

	.input {
		flex: 1;
		text-align: right;
		font-size: 28rpx;
	}

	.primary {
		margin-top: 20rpx;
		background-color: #ff8a65;
		color: #ffffff;
		border-radius: 12rpx;
	}

	.budget-track {
		height: 14rpx;
		background-color: #f2f3f5;
		border-radius: 7rpx;
		margin-top: 16rpx;
		overflow: hidden;
	}

	.budget-fill {
		height: 14rpx;
		background-color: #ff8a65;
		border-radius: 7rpx;
	}

	.bar-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-top: 18rpx;
	}

	.bar-name {
		width: 180rpx;
		font-size: 26rpx;
	}

	.bar-track {
		flex: 1;
		height: 14rpx;
		background-color: #f2f3f5;
		border-radius: 7rpx;
		margin-left: 12rpx;
		margin-right: 12rpx;
		overflow: hidden;
	}

	.bar-fill {
		height: 14rpx;
		background-color: #ff8a65;
		border-radius: 7rpx;
	}

	.bar-amount {
		width: 140rpx;
		text-align: right;
		font-size: 24rpx;
	}

	.trend {
		display: flex;
		flex-direction: row;
		align-items: flex-end;
		justify-content: space-between;
		height: 180rpx;
		margin-top: 20rpx;
	}

	.trend-col {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		flex: 1;
	}

	.trend-bar {
		width: 36rpx;
		background-color: #ff8a65;
		border-radius: 8rpx 8rpx 0 0;
	}
</style>
