<template>
	<view class="page">
		<view class="month-bar">
			<view class="month-arrow" @click="prevMonth">‹</view>
			<text class="month-title">{{ monthTitle(month) }}</text>
			<view class="month-arrow" @click="nextMonth">›</view>
		</view>

		<view class="tabs">
			<view class="tab" :class="{ 'tab-active': kind === 'expense' }" @click="kind = 'expense'">支出报表</view>
			<view class="tab" :class="{ 'tab-active': kind === 'income' }" @click="kind = 'income'">收入报表</view>
		</view>

		<view class="card summary-card">
			<text class="tiny">{{ kind === 'expense' ? '本月支出' : '本月收入' }}</text>
			<text class="summary-amount" :class="kind === 'expense' ? 'expense' : 'income'">{{ formatCents(total) }}</text>
			<view class="row-between summary-meta">
				<text class="tiny">{{ items.length }} 个分类 · {{ itemCount }} 笔{{ kind === 'expense' ? '支出' : '收入' }}</text>
				<text class="tiny">共 {{ overview.transaction_count }} 笔账单</text>
			</view>

			<view v-if="items.length > 0" class="allocation-bar">
				<view v-for="item in items" :key="item.category_id" class="allocation-seg" :style="'width:' + item.percent + '%;background-color:' + item.color"></view>
			</view>
		</view>

		<view class="card">
			<text class="section-title">分类排行</text>
			<view v-if="items.length === 0" class="empty">本月还没有{{ kind === 'expense' ? '支出' : '收入' }}记录</view>
			<view v-for="item in items" :key="item.category_id" class="rank-row">
				<view class="icon-circle">
					<text class="icon-emoji">{{ item.icon }}</text>
				</view>
				<view class="rank-main">
					<view class="row-between">
						<text class="rank-name">{{ item.name }}</text>
						<text class="amount" :class="kind === 'expense' ? 'expense' : 'income'">{{ formatCents(item.amount) }}</text>
					</view>
					<view class="bar-track">
						<view class="bar-fill" :style="'width:' + item.percent + '%;background-color:' + item.color"></view>
					</view>
					<text class="tiny">{{ item.percent }}% · {{ item.count }} 笔</text>
				</view>
			</view>
		</view>

		<view class="card">
			<view class="row-between">
				<text class="section-title">近 6 个月{{ kind === 'expense' ? '支出' : '收入' }}</text>
				<text class="tiny">单位：元</text>
			</view>
			<view class="trend">
				<view v-for="item in trend" :key="item.month" class="trend-col">
					<view class="trend-bars">
						<view class="trend-bar" :class="kind === 'expense' ? 'trend-expense' : 'trend-income'" :style="'height:' + trendHeight(trendValue(item)) + 'rpx'"></view>
					</view>
					<text class="tiny">{{ item.month.slice(5) }}月</text>
				</view>
			</view>
		</view>

		<view class="card">
			<view class="row-between">
				<text class="section-title">本月预算</text>
				<text class="tiny">已支出 {{ formatCents(overview.expense) }}</text>
			</view>
			<view class="budget-track">
				<view class="budget-fill" :style="'width:' + budgetPercent + '%'"></view>
			</view>
			<view class="row-between budget-meta">
				<text class="tiny">{{ budget.amount > 0 ? '预算 ' + formatCents(budget.amount) : '还没有设置预算' }}</text>
				<text class="tiny">{{ budget.amount > 0 ? '剩余 ' + formatCents(budgetLeft) : '' }}</text>
			</view>
			<view class="budget-edit">
				<input class="budget-input" v-model="budgetInput" type="digit" placeholder="输入预算金额" />
				<button class="btn-soft budget-save" @click="saveBudget">保存</button>
			</view>
		</view>

		<dango-tab-bar active="stats"></dango-tab-bar>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { useAuthStore } from '@/stores/auth.uts'
	import { useStatsStore } from '@/stores/stats.uts'
	import { useBudgetStore } from '@/stores/budget.uts'
	import { formatCents, yuanToCents } from '@/utils/money.uts'
	import { localMonth, monthTitle, shiftMonth } from '@/utils/date.uts'
	import DangoTabBar from '@/components/DangoTabBar.uvue'

	const auth = useAuthStore()
	const stats = useStatsStore()
	const budget = useBudgetStore()
	const month = ref(localMonth())
	const kind = ref('expense')
	const budgetInput = ref('')

	const overview = computed((): any => {
		if (stats.overview == null) {
			return { income: 0, expense: 0, balance: 0, transaction_count: 0, categories: [] }
		}
		return stats.overview
	})

	const items = computed((): any[] => {
		if (kind.value == 'income') return stats.incomeItems
		return overview.value.categories
	})

	const total = computed((): number => {
		if (kind.value == 'income') return stats.incomeTotal
		return overview.value.expense
	})

	const itemCount = computed((): number => {
		let count = 0
		for (let index = 0; index < items.value.length; index++) {
			count += items.value[index].count
		}
		return count
	})

	const trend = computed((): any[] => stats.trend)

	const budgetPercent = computed((): number => {
		if (budget.amount <= 0) return 0
		const percent = Math.round((overview.value.expense * 100) / budget.amount)
		return percent > 100 ? 100 : percent
	})

	const budgetLeft = computed((): number => budget.amount - overview.value.expense)

	onPageShow(() => {
		load()
	})

	async function load(): Promise<void> {
		if (!auth.loggedIn) return
		try {
			await stats.load(month.value)
			await stats.loadIncome(month.value)
			await budget.load(month.value)
			budgetInput.value = budget.amount > 0 ? (budget.amount / 100).toFixed(2) : ''
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}

	function prevMonth(): void {
		switchMonth(shiftMonth(month.value, -1))
	}

	function nextMonth(): void {
		const next = shiftMonth(month.value, 1)
		if (next > localMonth()) return
		switchMonth(next)
	}

	function switchMonth(target: string): void {
		month.value = target
		load()
	}

	function trendValue(item: any): number {
		return kind.value == 'income' ? item.income : item.expense
	}

	function trendHeight(amount: number): number {
		if (amount <= 0) return 0
		let max = 1
		for (let index = 0; index < trend.value.length; index++) {
			const value = trendValue(trend.value[index])
			if (value > max) max = value
		}
		const height = Math.round((amount * 120) / max)
		return height < 6 ? 6 : height
	}

	async function saveBudget(): Promise<void> {
		try {
			const cents = budgetInput.value.trim() === '' ? 0 : yuanToCents(budgetInput.value)
			await budget.save(month.value, cents)
			uni.showToast({ title: '预算已保存', icon: 'success' })
		} catch (error) {
			uni.showToast({ title: (error as Error).message, icon: 'none' })
		}
	}
</script>

<style>
	.month-bar {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		margin-bottom: 18rpx;
	}

	.month-arrow {
		width: 64rpx;
		height: 64rpx;
		border-radius: 32rpx;
		background-color: #ffffff;
		text-align: center;
		line-height: 58rpx;
		font-size: 40rpx;
		color: #526762;
		margin-left: 14rpx;
		margin-right: 14rpx;
	}

	.month-title {
		font-size: 32rpx;
		font-weight: 600;
		min-width: 220rpx;
		text-align: center;
	}

	.tabs {
		display: flex;
		flex-direction: row;
		background-color: #ffffff;
		border-radius: 999rpx;
		padding: 8rpx;
		margin-bottom: 20rpx;
	}

	.tab {
		flex: 1;
		text-align: center;
		padding: 16rpx 0;
		border-radius: 999rpx;
		font-size: 26rpx;
		color: #6c7766;
	}

	.tab-active {
		background-color: #2e9e8f;
		color: #ffffff;
		font-weight: 600;
	}

	.summary-card {
		padding-bottom: 24rpx;
	}

	.summary-amount {
		display: block;
		font-size: 54rpx;
		font-weight: 700;
		margin-top: 6rpx;
	}

	.summary-meta {
		margin-top: 12rpx;
	}

	.allocation-bar {
		display: flex;
		flex-direction: row;
		height: 18rpx;
		border-radius: 9rpx;
		overflow: hidden;
		margin-top: 20rpx;
		background-color: #e8f2ee;
	}

	.allocation-seg {
		height: 18rpx;
	}

	.rank-row {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		margin-top: 22rpx;
	}

	.rank-main {
		flex: 1;
		margin-left: 16rpx;
	}

	.rank-name {
		font-size: 28rpx;
	}

	.bar-track {
		height: 10rpx;
		background-color: #e8f2ee;
		border-radius: 5rpx;
		margin-top: 8rpx;
		margin-bottom: 4rpx;
		overflow: hidden;
	}

	.bar-fill {
		height: 10rpx;
		border-radius: 5rpx;
	}

	.legend {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.legend-dot {
		width: 12rpx;
		height: 12rpx;
		border-radius: 6rpx;
		margin-left: 12rpx;
		margin-right: 6rpx;
	}

	.legend-expense {
		background-color: #d96b6b;
	}

	.legend-income {
		background-color: #2e9e8f;
	}

	.trend {
		display: flex;
		flex-direction: row;
		align-items: flex-end;
		justify-content: space-between;
		height: 170rpx;
		margin-top: 22rpx;
	}

	.trend-col {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		flex: 1;
	}

	.trend-bars {
		display: flex;
		flex-direction: row;
		align-items: flex-end;
		height: 126rpx;
	}

	.trend-bar {
		width: 22rpx;
		border-radius: 7rpx 7rpx 0 0;
	}

	.trend-expense {
		background-color: #d96b6b;
	}

	.trend-income {
		background-color: #2e9e8f;
	}

	.budget-track {
		height: 16rpx;
		background-color: #e8f2ee;
		border-radius: 8rpx;
		margin-top: 20rpx;
		overflow: hidden;
	}

	.budget-fill {
		height: 16rpx;
		background-color: #f2a6b7;
		border-radius: 8rpx;
	}

	.budget-meta {
		margin-top: 10rpx;
	}

	.budget-edit {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-top: 18rpx;
	}

	.budget-input {
		flex: 1;
		height: 72rpx;
		background-color: #edf6f2;
		border-radius: 999rpx;
		padding-left: 24rpx;
		font-size: 26rpx;
	}

	.budget-save {
		margin-left: 14rpx;
	}
</style>
