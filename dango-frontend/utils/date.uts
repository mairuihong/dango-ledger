function pad(value: number): string {
	return value < 10 ? '0' + value.toString() : value.toString()
}

/** YYYY-MM-DD（本地时区） */
export function localDate(date: Date = new Date()): string {
	return date.getFullYear().toString() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate())
}

/** YYYY-MM（本地时区） */
export function localMonth(date: Date = new Date()): string {
	return date.getFullYear().toString() + '-' + pad(date.getMonth() + 1)
}

/** 本地日期中午的 ISO 字符串，避免时区把日期推到前后一天 */
export function localNoonIso(dateText: string): string {
	const date = new Date(dateText + 'T12:00:00')
	return date.toISOString()
}

export function todayIso(): string {
	return localNoonIso(localDate())
}

/** 最近 N 个月的 YYYY-MM 列表，从旧到新 */
export function recentMonths(count: number): string[] {
	const result: string[] = []
	const now = new Date()
	for (let index = count - 1; index >= 0; index--) {
		const date = new Date(now.getFullYear(), now.getMonth() - index, 1)
		result.push(localMonth(date))
	}
	return result
}

/** 月份偏移，delta 可为负 */
export function shiftMonth(month: string, delta: number): string {
	const year = parseInt(month.slice(0, 4))
	const monthIndex = parseInt(month.slice(5, 7)) - 1
	return localMonth(new Date(year, monthIndex + delta, 1))
}

/** 2026-10 → 2026年10月 */
export function monthTitle(month: string): string {
	return month.slice(0, 4) + '年' + month.slice(5, 7) + '月'
}

export function daysInMonth(month: string): number {
	const year = parseInt(month.slice(0, 4))
	const monthIndex = parseInt(month.slice(5, 7))
	return new Date(year, monthIndex, 0).getDate()
}

/** 周一为 0，周日为 6 */
export function firstWeekday(month: string): number {
	const year = parseInt(month.slice(0, 4))
	const monthIndex = parseInt(month.slice(5, 7)) - 1
	const day = new Date(year, monthIndex, 1).getDay()
	return (day + 6) % 7
}

export function dayText(month: string, day: number): string {
	const dayString = day < 10 ? '0' + day.toString() : day.toString()
	return month + '-' + dayString
}
